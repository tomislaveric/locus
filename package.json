{
  "name": "post-ride-ar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:sync": "tsx src/runSyncValidation.ts",
    "migrate": "tsx src/persistence/migrate.ts",
    "test:persistence": "TEST_DATABASE_URL=${TEST_DATABASE_URL:?TEST_DATABASE_URL is required} vitest run src/persistence/activityRepository.test.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "fit-file-parser": "^2.3.3",
    "gopro-telemetry": "^1.2.11",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
