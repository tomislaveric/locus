# Copy to /opt/staza/dev/.env and replace all placeholders with unique values.
STAZA_IMAGE=ghcr.io/tomislaveric/staza
STAZA_IMAGE_TAG=sha-0000000000000000000000000000000000000000

POSTGRES_DB=staza_dev
POSTGRES_USER=staza_dev
POSTGRES_PASSWORD=replace-with-a-unique-random-password
# URL-encode any reserved characters in the password used in DATABASE_URL.
DATABASE_URL=postgres://staza_dev:URL_ENCODED_PASSWORD@postgres:5432/staza_dev

WEBAUTHN_RP_ID=dev.play.staza.world
WEBAUTHN_RP_NAME=Staza
WEBAUTHN_ORIGIN=https://dev.play.staza.world
